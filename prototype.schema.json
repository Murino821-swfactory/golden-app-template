{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "patterns": {
    "landing": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hero",
              "features",
              "pricing",
              "testimonials",
              "faq",
              "contact",
              "cta"
            ]
          }
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "subheadline": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "description"
            ]
          }
        }
      },
      "required": [
        "sections"
      ]
    },
    "dashboard": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title"
      ]
    },
    "authGoogle": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "cta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "contactForm": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "submitLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "heading",
        "submitLabel"
      ]
    },
    "dataGrid": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entity": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "longtext",
                      "number",
                      "date",
                      "boolean",
                      "select"
                    ]
                  },
                  "options": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "key",
                  "label",
                  "type"
                ]
              }
            }
          },
          "required": [
            "key",
            "label",
            "fields"
          ]
        }
      },
      "required": [
        "entity"
      ]
    },
    "mapBase": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "center": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lng"
          ]
        },
        "zoom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "center",
        "zoom"
      ]
    }
  },
  "root": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "appName": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "theme": {
        "type": "object",
        "properties": {
          "colorScheme": {
            "type": "string",
            "enum": [
              "red",
              "blue",
              "yellow",
              "green"
            ]
          },
          "style": {
            "type": "string",
            "enum": [
              "minimal",
              "bold",
              "playful"
            ]
          }
        },
        "required": [
          "colorScheme",
          "style"
        ]
      },
      "patterns": {
        "type": "object",
        "properties": {
          "landing": {
            "type": "object",
            "properties": {
              "sections": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "hero",
                    "features",
                    "pricing",
                    "testimonials",
                    "faq",
                    "contact",
                    "cta"
                  ]
                }
              },
              "headline": {
                "type": "string",
                "minLength": 1
              },
              "subheadline": {
                "type": "string",
                "minLength": 1
              },
              "features": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "icon": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "title",
                    "description"
                  ]
                }
              }
            },
            "required": [
              "sections"
            ]
          },
          "dashboard": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title"
            ]
          },
          "authGoogle": {
            "type": "object",
            "properties": {}
          },
          "cta": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "href"
            ]
          },
          "contactForm": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "submitLabel": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "heading",
              "submitLabel"
            ]
          },
          "dataGrid": {
            "type": "object",
            "properties": {
              "entity": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fields": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "text",
                            "longtext",
                            "number",
                            "date",
                            "boolean",
                            "select"
                          ]
                        },
                        "options": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "key",
                        "label",
                        "type"
                      ]
                    }
                  }
                },
                "required": [
                  "key",
                  "label",
                  "fields"
                ]
              }
            },
            "required": [
              "entity"
            ]
          },
          "mapBase": {
            "type": "object",
            "properties": {
              "center": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": [
                  "lat",
                  "lng"
                ]
              },
              "zoom": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "center",
              "zoom"
            ]
          }
        }
      }
    },
    "required": [
      "appName",
      "description",
      "theme",
      "patterns"
    ]
  }
}
