{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "menu": {
    "patterns": {
      "landing": {
        "purpose": "The public page every visitor lands on. Always enabled — every other pattern sits behind auth or below the fold, so a prototype without it opens on nothing."
      },
      "dashboard": {
        "purpose": "A signed-in home screen summarising the user's own data. Pick it when the idea describes something people return to and track over time, rather than read once."
      },
      "authGoogle": {
        "purpose": "Google sign-in plus a route guard. Pick it whenever the idea implies personal data, saved work or anything described as 'my' — accounts, history, preferences."
      },
      "cta": {
        "purpose": "A closing call-to-action band on the landing page. Pick it when the idea has one obvious next step for a visitor: book, request, subscribe, start a trial."
      },
      "contactForm": {
        "purpose": "A contact form that captures a message and an email address. Pick it for services, consultancies and anything sold through a conversation rather than a signup."
      },
      "useCases": {
        "purpose": "Concrete situations where the product helps. Pick when the idea names distinct audiences or jobs; describe their actions, without invented customers or results."
      },
      "comparison": {
        "purpose": "A side-by-side comparison of the current workflow and the proposed workflow. Pick when the idea explicitly describes an alternative; never invent competitor claims, savings or prices."
      },
      "dataGrid": {
        "purpose": "A table of records the user adds, edits and filters. Pick it when the idea is about keeping track of things — an inventory, a catalogue, a register, a log of entries."
      },
      "mapBase": {
        "purpose": "A map with points the user can place and inspect. Pick it only when location is part of the idea itself, not merely mentioned — routes, venues, coverage, territory."
      }
    },
    "sections": {
      "selectable": [
        "hero",
        "features",
        "howItWorks",
        "useCases",
        "comparison",
        "faq",
        "contact",
        "cta"
      ],
      "copySource": {
        "hero": "landing",
        "features": "landing",
        "contact": "contactForm",
        "cta": "cta",
        "faq": "landing",
        "howItWorks": "landing",
        "useCases": "useCases",
        "comparison": "comparison",
        "pricing": null,
        "testimonials": null
      }
    },
    "locales": [
      "en",
      "sk",
      "cs",
      "de",
      "pl",
      "hu",
      "fr",
      "es"
    ]
  },
  "patterns": {
    "landing": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hero",
              "features",
              "howItWorks",
              "useCases",
              "comparison",
              "pricing",
              "testimonials",
              "faq",
              "contact",
              "cta"
            ]
          }
        },
        "presentation": {
          "description": "Story keeps a desktop stage in place while chapters enter on native scroll. Mobile, reduced motion and no JavaScript use a document. Omit for story; choose document for long-form pages.",
          "type": "string",
          "enum": [
            "story",
            "document"
          ]
        }
      },
      "required": [
        "sections"
      ]
    },
    "dashboard": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kpis": {
          "description": "The one to three numbers this user checks first. Prefer a share of a status over a raw count. agg \"count\" takes field \"*\"; \"sum\"/\"avg\" a number field; \"share\" a select field plus one of its options as value.",
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$"
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "agg": {
                "type": "string",
                "enum": [
                  "count",
                  "sum",
                  "avg",
                  "share"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "field",
              "agg"
            ]
          }
        }
      }
    },
    "authGoogle": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
