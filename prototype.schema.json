              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lng"
          ]
        },
        "zoom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
