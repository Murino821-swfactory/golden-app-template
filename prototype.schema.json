      "type": "object",
      "properties": {
        "entity": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "longtext",
                      "number",
                      "date",
                      "boolean",
                      "select"
                    ]
                  },
                  "options": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "key",
                  "type"
                ]
              }
            }
          },
          "required": [
            "key",
            "fields"
          ]
        }
      },
      "required": [
        "entity"
      ]
    },
    "mapBase": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "center": {
          "type": "object",
